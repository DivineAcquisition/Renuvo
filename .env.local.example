# The public address of the site, used for link previews. In production: https://selestial.io
NEXT_PUBLIC_SITE_ORIGIN=

# The Convex deployment the site talks to, for example https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# A long random value shared by this server and Convex (set the same value on the Convex deployment:
# npx convex env set PUBLIC_FORM_SECRET <value>). Early-access requests are saved only when both this and
# NEXT_PUBLIC_CONVEX_URL are set. Until then the form tells the visitor that requests are not open.
PUBLIC_FORM_SECRET=

# Sign-in (Clerk). Both are needed before anyone can open /app. Until they are set, /app and /sign-in
# say that sign-in is not set up. The secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
