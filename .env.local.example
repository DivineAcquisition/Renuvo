# The public address of the site, used for link previews, canonical links and the sitemap.
# In production: https://www.selestial.io
NEXT_PUBLIC_SITE_ORIGIN=

# The other hosts this one app answers on (docs/foundation/02-hosts.md). Each is an origin, such as
# https://app.selestial.io. Leave them empty locally: a host no setting names can reach every page.
# Once a host is set, it shows only its own pages.
#   APP_ORIGIN     the signed-in workspace and sign-in
#   LINK_ORIGIN    the link pages sent in texts (set the same value on the Convex deployment)
#   ADMIN_ORIGIN, DOCS_ORIGIN, STATUS_ORIGIN   attached but not built: they answer "not found"
APP_ORIGIN=
LINK_ORIGIN=
ADMIN_ORIGIN=
DOCS_ORIGIN=
STATUS_ORIGIN=

# The Convex deployment the site talks to, for example https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# A long random value shared by this server and Convex (set the same value on the Convex deployment:
# npx convex env set PUBLIC_FORM_SECRET <value>). Early-access requests are saved only when both this and
# NEXT_PUBLIC_CONVEX_URL are set. Until then the form tells the visitor that requests are not open.
PUBLIC_FORM_SECRET=

# Sign-in (docs/foundation/03-authentication.md). Both are needed before anyone can open /app. Until
# they are set, /app and /login say that sign-in is not set up. The secret key is server-only.
# The record must also trust the same instance: on the Convex deployment, CLERK_JWT_ISSUER_DOMAIN.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dispatch (set these on the Convex deployment with `npx convex env set`, not in this file):
#   ACTION_LINK_SECRET   a long random value (32+ characters). Signs the links cleaners act through.
#                        Without it no link can be issued or opened.
#   LINK_ORIGIN          the host the link pages are served on, for example https://link.selestial.io.
#                        The one setting every texted link is built from. Falls back to SITE_ORIGIN.
#   MESSAGING_PROVIDER   "mock" for development. Unset means texts are recorded as not sent.
#                        No real provider is connected yet.

# Inviting people into a company (also set on the Convex deployment with `npx convex env set`):
#   ACTION_LINK_SECRET   the same secret as above also signs invitation links, with different words, so
#                        neither kind of link opens the other. Without it nobody can be invited.
#   APP_ORIGIN           the address of the app, for example https://app.selestial.io. The invitation
#                        link in the email is built from it. Falls back to SITE_ORIGIN. With neither set,
#                        no invitation email is sent and the Owner copies the link by hand.
#   EMAIL_PROVIDER       "resend" for real mail, "mock" for development. Unset means email is not
#                        connected: invitations are still made, and the Owner copies the link by hand.
#   RESEND_API_KEY       the Resend API key. Needed when EMAIL_PROVIDER is "resend".
#   EMAIL_FROM           the sender, for example Selestial <team@selestial.io>, on a domain verified
#                        with Resend. Needed when EMAIL_PROVIDER is "resend".
