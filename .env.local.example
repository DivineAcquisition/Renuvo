# The public address of the site, used for link previews. Example: https://renuvo.com
NEXT_PUBLIC_SITE_ORIGIN=

# The scheduling link behind "Book a call" (https only). Until set, the button goes to the waitlist form.
NEXT_PUBLIC_BOOKING_URL=

# Where a waitlist entry is sent as JSON (https only, server side). Until set, the form says the waitlist is not open.
WAITLIST_WEBHOOK_URL=
