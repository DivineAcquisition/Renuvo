# The public address of the site, used for link previews, canonical links and the sitemap.
# In production: https://www.selestial.io
NEXT_PUBLIC_SITE_ORIGIN=

# The other hosts this one app answers on (docs/foundation/02-hosts.md). Each is an origin, such as
# https://app.selestial.io. Leave them empty locally: a host no setting names can reach every page.
# Once a host is set, it shows only its own pages.
#   APP_ORIGIN     the signed-in workspace and sign-in
#   LINK_ORIGIN    the link pages sent in texts (set the same value on the Convex deployment)
#   ADMIN_ORIGIN, DOCS_ORIGIN, STATUS_ORIGIN   attached but not built: they answer "not found"
APP_ORIGIN=
LINK_ORIGIN=
ADMIN_ORIGIN=
DOCS_ORIGIN=
STATUS_ORIGIN=

# The Convex deployment the site talks to, for example https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# A long random value shared by this server and Convex (set the same value on the Convex deployment:
# npx convex env set PUBLIC_FORM_SECRET <value>). Early-access requests are saved only when both this and
# NEXT_PUBLIC_CONVEX_URL are set. Until then the form tells the visitor that requests are not open.
PUBLIC_FORM_SECRET=

# Sign-in (docs/foundation/03-authentication.md). Both are needed before anyone can open /app. Until
# they are set, /app and /login say that sign-in is not set up. The secret key is server-only.
# The record must also trust the same instance: on the Convex deployment, CLERK_JWT_ISSUER_DOMAIN.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Address search on every address field (docs/integrations/00-plan.md, phase 2). A Google Maps Platform
# browser key with Places API (New) enabled, restricted to this site's addresses. Empty: plain fields.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Dispatch (set these on the Convex deployment with `npx convex env set`, not in this file):
#   ACTION_LINK_SECRET   a long random value (32+ characters). Signs the links cleaners act through.
#                        Without it no link can be issued or opened.
#   LINK_ORIGIN          the host the link pages are served on, for example https://link.selestial.io.
#                        The one setting every texted link is built from. Falls back to SITE_ORIGIN.
#   MESSAGING_PROVIDER   "telnyx" for real texts, "mock" for development. Unset means texts are recorded
#                        as not sent.
#   TELNYX_API_KEY       the Telnyx API v2 key. Needed when MESSAGING_PROVIDER is "telnyx".
#   TELNYX_PUBLIC_KEY    the account's webhook public key (Mission Control > Keys & Credentials > Public
#                        Key). Webhooks that do not verify against it are refused.
#   TELNYX_MESSAGING_PROFILE_ID  optional. Each text also names this deployment's webhook address, so
#                        delivery reports arrive whatever the profile points at. Texts coming IN arrive at
#                        the profile's webhook: point the company number's profile at
#                        https://<deployment>.convex.site/webhooks/telnyx.

# Recruiter (set these on the Convex deployment with `npx convex env set`, not in this file):
#   EMAIL_PROVIDER, RESEND_API_KEY, EMAIL_FROM   the same ones invitations use, below. Applicant email goes
#                          from EMAIL_FROM's address under the company's name, with replies to the company's
#                          hiring inbox.
#   RESEND_WEBHOOK_SECRET  The signing secret (whsec_...) of the Resend webhook pointed at
#                          https://<deployment>.convex.site/webhooks/resend (events: delivered, bounced, complained, failed).
#   RECRUITER_MODEL        "claude" to have Claude recognise and read hiring mail. Unset: the rules reader.
#   ANTHROPIC_API_KEY      Needed when RECRUITER_MODEL is "claude".
#   RECRUITER_EMAIL_FROM   The address applicant email comes from until a company connects its own inbox,
#                          for example noreply@mail.selestial.io. Must be on EMAIL_FROM's domain; otherwise
#                          EMAIL_FROM's address is used.
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   A Google OAuth web client with the Gmail API enabled and the
#                          redirect URI https://<deployment>.convex.site/oauth/google/callback. Lets an Owner
#                          connect a Gmail hiring inbox (read, and optionally send).
#   MAILBOX_TOKEN_KEY      32 random bytes, base64 (`openssl rand -base64 32`). Seals each company's Gmail
#                          authorization at rest. Changing it disconnects every inbox until it is reconnected.
# Inviting people into a company (also set on the Convex deployment with `npx convex env set`):
#   ACTION_LINK_SECRET   the same secret as above also signs invitation links, with different words, so
#                        neither kind of link opens the other. Without it nobody can be invited.
#   APP_ORIGIN           the address of the app, for example https://app.selestial.io. The invitation
#                        link in the email is built from it. Falls back to SITE_ORIGIN. With neither set,
#                        no invitation email is sent and the Owner copies the link by hand.
#   EMAIL_PROVIDER       "resend" for real mail, "mock" for development. Unset means email is not
#                        connected: invitations are still made, and the Owner copies the link by hand.
#   RESEND_API_KEY       the Resend API key. Needed when EMAIL_PROVIDER is "resend".
#   EMAIL_FROM           the sender, for example Selestial <team@selestial.io>, on a domain verified
#                        with Resend. Needed when EMAIL_PROVIDER is "resend".

# Plans and credits (set on the Convex deployment with `npx convex env set`, not in this file). See docs/billing/README.md.
#   AUTUMN_SECRET_KEY      Autumn's secret key. am_sk_test_... is the sandbox, am_sk_live_... is production.
#                          Unset: billing is not connected and AI work is paused (records and non-AI work run).
#   AUTUMN_WEBHOOK_SECRET  The signing secret (whsec_...) of the Autumn webhook pointed at
#                          https://<deployment>.convex.site/webhooks/autumn.
#   BILLING_RATE_CARD      The credit rate card in force (convex/lib/billing/rateCards.ts). "fixture-2026-11"
#                          holds test values and is refused with a live key; "2026-11" has no approved rates yet.
#   BILLING_TOP_UP_PACKS   Top-up sizes offered, in credits, e.g. "500,2000". Unset: top-ups are not on sale.

# Finance: the cleaning company's own money (docs/finance/00-plan.md). Set on the Convex deployment with `npx convex env set`:
#   STRIPE_SECRET_KEY               Selestial's Stripe platform key (sk_test_... or sk_live_...). Unset: customers can't pay by card,
#                                   and Finance says so; invoices, pay links and recorded payments still work.
#   STRIPE_PUBLISHABLE_KEY          The matching pk_ key, for the pay page's payment form.
#   STRIPE_CONNECT_WEBHOOK_SECRET   The whsec_ of the Connect webhook pointed at https://<deployment>.convex.site/webhooks/stripe.
